# Mapbox — https://account.mapbox.com/access-tokens/ → create a public token
# Required for the Map page. Leave blank to show the placeholder instead of a live map.
NUXT_PUBLIC_MAPBOX_TOKEN=

# Neon DB — https://console.neon.tech → your project → Connection Details
# The app uses the pooled connection string (DATABASE_URL). Drizzle migrations
# use the DIRECT (non-pooler) string; in .env.production that is
# DATABASE_URL_UNPOOLED (host without `-pooler`), which drizzle.config prefers.
# See "Migrations in CI" in the README.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Clerk — https://dashboard.clerk.com → API Keys
NUXT_CLERK_SECRET_KEY=sk_test_...
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk webhook signing secret — https://dashboard.clerk.com → Webhooks → your endpoint → Signing Secret
NUXT_CLERK_WEBHOOK_SECRET=whsec_...

# Stripe — https://dashboard.stripe.com/apikeys → Secret key (use a test-mode key
# for local/staging). Used server-side only to create Checkout/Billing Portal
# sessions and to sync subscriptions from webhook events. See README "Billing".
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks → your
# endpoint → Signing Secret. Verifies the Stripe-Signature header on
# server/api/webhooks/stripe.post.ts. See README "Billing" section.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — https://dashboard.stripe.com/products → create a
# "Wanderer" and a "Nomad" product, each with a monthly and a yearly recurring
# Price (see README "Billing" section for exact amounts), then copy each
# Price's ID here. Leave any of these blank and the matching /pricing checkout
# button disables itself instead of opening a broken checkout.
STRIPE_PRICE_WANDERER_MONTHLY=
STRIPE_PRICE_WANDERER_YEARLY=
STRIPE_PRICE_NOMAD_MONTHLY=
STRIPE_PRICE_NOMAD_YEARLY=

# Invite-only mode — set to "true" to block new-user provisioning. Existing users
# keep working; a new Clerk account gets no usable app-DB row (403). Leave blank to
# allow sign-ups (default). Set "true" in production while the app is being built.
NUXT_DISABLE_SIGNUPS=

# Sentry — https://sentry.io → Settings → Projects → Client Keys (DSN)
NUXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=danholloran
SENTRY_PROJECT=wanderist

# Instagram Graph API — https://developers.facebook.com → My Apps → your app → Settings
# Requires a Facebook App connected to a Business or Creator Instagram account.
# Set the OAuth redirect URI in the app dashboard to: https://<your-domain>/api/connections/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Token encryption — used to encrypt OAuth access tokens stored in the database.
# Generate a secure key with: openssl rand -hex 32
# Must be a 64-character hex string (32 bytes / 256 bits).
TOKEN_ENCRYPTION_KEY=

# Public origin — used to build the Instagram OAuth redirect URI server-side.
# Example: https://wanderist.app  (no trailing slash)
NUXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Google Analytics — https://analytics.google.com → Admin → Data Streams → your
# web stream → Measurement ID (starts with "G-"). Set only in .env.production;
# leave blank elsewhere. Blank disables analytics, and it never loads in
# `nuxt dev`, so GA runs in production builds alone.
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Netlify Blobs — used for media file storage (uploads).
# These are auto-injected by Netlify at runtime (Functions / SSR). You do NOT
# need to set them when deploying; Netlify provides them automatically.
# For local development outside of `netlify dev`, set them manually:
#   NETLIFY_SITE_ID  — your Netlify project ID (Project settings → General)
#   NETLIFY_AUTH_TOKEN — a personal access token (User settings → OAuth → Personal access tokens)
# Leave these blank when running via `netlify dev`; the CLI injects them.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

NEON_API_KEY=
NEON_PROJECT_ID=

# Rate limiting — set to "true" only in the Netlify site's environment
# variables (Project settings → Environment variables), never locally. Tells
# server/middleware/rateLimit.ts it's safe to trust the
# x-nf-client-connection-ip header (Netlify's edge sets it and it can't be
# client-spoofed) for IP-based rate-limit bucketing. Leave unset anywhere
# else — the header would otherwise be fully attacker-controlled.
TRUST_NETLIFY_CLIENT_IP=
